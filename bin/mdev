#!/usr/bin/env bash
# mdev shim — resolves the designated Movian core and hands off to its own mdev.
# Contract: movian-plugin-sdk#3. Stood up by movian-plugin-sdk#12.
set -euo pipefail

MOVIAN_SDK_LIB="${MOVIAN_SDK_LIB:-$HOME/.local/lib/movian-sdk}"  # rewritten by install.sh
MOVIAN_SDK_ROOT="${MOVIAN_SDK_ROOT:-}"                           # rewritten by install.sh
. "$MOVIAN_SDK_LIB/locate.sh"

# `mdev core` prints the resolved core root and nothing else, so docs and scripts
# can reach into the checkout from a plugin repo:
#   (cd "$(mdev core)/support/devtools" && python3 -m mdevlib.movian_agent ...)
if [ "${1:-}" = "core" ]; then
  movian_sdk_locate || exit 1
  printf '%s\n' "$MOVIAN_SDK_CORE"
  exit 0
fi

# `mdev types` materialises the generated Plugin API declarations into the current
# repo, so a committed tsconfig.json can reference a stable relative path instead
# of a machine-specific one. A symlink by default: it cannot go stale as the core
# is rebuilt. `--copy` vendors a snapshot instead, for a repo that must typecheck
# without a core checkout.
#
# It then checks that the artifact it just handed over can actually catch a
# defect (movian#183). This is the point of consumption -- the moment the author
# starts trusting a green `tsc` -- and it is the last one where a useless
# artifact can still be reported as useless. `--no-verify` skips it; nothing else
# does, because "could not check" must not read the same as "checked, fine".
if [ "${1:-}" = "types" ]; then
  shift
  movian_sdk_locate || exit 1
  src="$MOVIAN_SDK_CORE/generated/movian-api.d.ts"
  out="types/movian-api.d.ts"
  mode="link"
  verify=1
  while [ $# -gt 0 ]; do
    case "$1" in
      --copy) mode="copy" ;;
      --no-verify) verify=0 ;;
      --out) shift; out="$1" ;;
      *) echo "mdev types: unknown argument '$1'" >&2; exit 2 ;;
    esac
    shift
  done
  if [ ! -f "$src" ]; then
    echo "mdev types: $src does not exist." >&2
    echo "  fix: cd '$MOVIAN_SDK_CORE' && python3 support/devtools/metadata/gen.py" >&2
    exit 1
  fi
  mkdir -p "$(dirname "$out")"
  if [ "$mode" = "copy" ]; then
    cp -f "$src" "$out"
  else
    ln -sfn "$src" "$out"
  fi
  echo "$out -> $src ($mode)"
  echo "note: gitignore it unless you deliberately vendor a snapshot."
  [ "$verify" -eq 1 ] || exit 0
  echo
  # Propagate typefloor's status verbatim: it distinguishes 1 (the artifact
  # does not check a plugin) from 2 (we could not find out). Collapsing them
  # would tell a caller an artifact failed when nothing examined it.
  python3 "$MOVIAN_SDK_LIB/typefloor.py" --dts "$out"
  exit $?
fi

# `mdev viewdoc` is answered HERE because the canon split moved its inputs. The
# GLW reference docs it validates are this plugin's (movian:view), while the
# artifact it validates them against is the core's. Keeping the checker beside
# the docs means the dependency runs SDK -> core only; the core carries no
# knowledge of where the docs went (movian-plugin-sdk#18, was movian#88/#98).
if [ "${1:-}" = "viewdoc" ]; then
  shift
  movian_sdk_locate || exit 1
  if [ -z "$MOVIAN_SDK_ROOT" ]; then
    echo "mdev viewdoc: SDK root unknown — this shim was not installed by install.sh." >&2
    echo "  fix: re-run ./install.sh from the movian-plugin-sdk checkout," >&2
    echo "       or set MOVIAN_SDK_ROOT to it for this session." >&2
    exit 2
  fi
  refs="$MOVIAN_SDK_ROOT/plugins/movian/skills/view/references"
  if [ ! -d "$refs" ]; then
    echo "mdev viewdoc: '$MOVIAN_SDK_ROOT' is not a movian-plugin-sdk checkout ($refs missing)." >&2
    echo "  fix: correct MOVIAN_SDK_ROOT, or re-run install.sh from the checkout." >&2
    exit 2
  fi
  exec python3 "$MOVIAN_SDK_LIB/viewdoc.py" \
    --metadata "$MOVIAN_SDK_CORE/generated/movian-metadata.json" \
    --refs "$refs" "$@"
fi

# `mdev doctor` is answered HERE, not by the core: the locator facts (which core,
# how it resolved) are the shim's knowledge. The core's own `mdev lsp doctor`
# stays untouched and is delegated to at the end.
if [ "${1:-}" = "doctor" ]; then
  shift
  rc=0
  if ! movian_sdk_locate; then
    echo "locator: UNRESOLVED"
    exit 1
  fi
  echo "core:      $MOVIAN_SDK_CORE"
  echo "resolved:  via $MOVIAN_SDK_CORE_SOURCE"

  bin="$MOVIAN_SDK_CORE/build.debug/movian"
  echo "binary:    $(date -r "$bin" '+%Y-%m-%d %H:%M:%S') ($("$bin" --help 2>/dev/null | head -1))"

  if git -C "$MOVIAN_SDK_CORE" rev-parse --git-dir >/dev/null 2>&1; then
    head_sha="$(git -C "$MOVIAN_SDK_CORE" rev-parse --short HEAD)"
    branch="$(git -C "$MOVIAN_SDK_CORE" branch --show-current)"
    echo "checkout:  $branch @ $head_sha$(git -C "$MOVIAN_SDK_CORE" diff --quiet 2>/dev/null || echo ' (dirty)')"

    newer="$(find "$MOVIAN_SDK_CORE/src" -name '*.c' -newer "$bin" 2>/dev/null | wc -l)"
    if [ "$newer" -gt 0 ]; then
      echo "freshness: $newer C source file(s) newer than the binary — rebuild if that matters"
    else
      echo "freshness: binary is newer than all C sources"
    fi

    if git -C "$MOVIAN_SDK_CORE" rev-parse --verify origin/movian6 >/dev/null 2>&1; then
      behind="$(git -C "$MOVIAN_SDK_CORE" rev-list --count HEAD..origin/movian6 2>/dev/null)"
      echo "upstream:  $behind commit(s) behind origin/movian6 (as last fetched)"
    fi
  fi

  for tool in mdev mdevlib metadata movian-lsp lsp analyze smokes viewpreview gdb; do
    [ -e "$MOVIAN_SDK_CORE/support/devtools/$tool" ] || { echo "devtools:  MISSING $tool"; rc=1; }
  done
  # `|| true`: under `set -e` a false test as the last command of the branch
  # would abort the doctor here, skipping every check below it.
  { [ "$rc" -eq 0 ] && echo "devtools:  complete"; } || true

  # The checks above all ask the checkout about itself, so a checkout that is
  # merely old answers every one of them correctly. This one asks whether the
  # artifact an author compiles against still catches anything (movian#183).
  dts="$MOVIAN_SDK_CORE/generated/movian-api.d.ts"
  if [ ! -f "$dts" ]; then
    echo "typefloor: MISSING $dts"
    rc=1
  else
    floor_rc=0
    floor="$(python3 "$MOVIAN_SDK_LIB/typefloor.py" --dts "$dts" 2>&1)" || floor_rc=$?
    printf 'typefloor: %s\n' "$(printf '%s\n' "$floor" | head -1 | sed 's/^typefloor: //')"
    if [ "$floor_rc" -ne 0 ]; then
      printf '%s\n' "$floor" | tail -n +2
      rc=1
    fi
  fi

  echo
  echo "--- core: mdev lsp doctor ---"
  "$MOVIAN_SDK_CORE/support/devtools/mdev" lsp doctor || rc=$?
  exit "$rc"
fi

movian_sdk_locate || exit 1

# `mdev preview <view> [--fixture f]` and `mdev watch --dir <d>` absolutise a
# relative path against the CORE checkout, not the caller's cwd
# (mdevlib/cli.py: resolve_repo_path). From a plugin repo that silently aims at
# a path inside the core that does not exist -- `mdev preview views/x.view` in a
# plugin becomes "<core>/views/x.view". Every other path argument (-p, --skin)
# already uses the caller's cwd, so this one is the odd one out.
#
# Fixing it in the core is out of this layer's scope, but the shim is exactly
# where caller-cwd knowledge belongs. Rewrite such an argument to an absolute
# path **only when it actually exists relative to the cwd** -- so the core's
# repo-relative fallback still resolves anything that does not, and a core
# developer sees no change.
absolutise() {
  case "$1" in
    /*) printf '%s\n' "$1"; return ;;
  esac
  if [ -e "$PWD/$1" ]; then
    printf '%s\n' "$(cd "$(dirname "$PWD/$1")" && pwd)/$(basename "$1")"
  else
    printf '%s\n' "$1"
  fi
}

case "${1:-}" in
  preview|watch)
    args=("$1"); shift
    prev=""
    for a in "$@"; do
      # Rewrite a bare path-shaped argument that exists relative to cwd.
      # Skip anything option-shaped, and skip the value of --name, which is an
      # instance label and could collide with a directory of the same name.
      case "$a" in
        -*) ;;
        *) [ "$prev" = "--name" ] || a="$(absolutise "$a")" ;;
      esac
      args+=("$a"); prev="$a"
    done
    set -- "${args[@]}"
    ;;
esac

exec "$MOVIAN_SDK_CORE/support/devtools/mdev" "$@"
